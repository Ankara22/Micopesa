{
  "name": "micopesa",
  "private": true,
  "scripts": {
    "test": "npm run test:unit && npm run test:web",
    "test:unit": "node tests/scripts/runApiUnitTests.js",
    "test:unit:coverage": "node tests/scripts/runApiUnitTests.js --coverage",
    "test:web": "npm --prefix apps/web run test",
    "test:frontend": "npm run test:web",
    "test:api": "npm run test:unit",
    "test:integration": "node tests/scripts/runIntegrationTests.js",
    "test:integration:micopesa": "node tests/scripts/runMicopesaIntegrationTests.js",
    "test:db": "node tests/scripts/runDatabaseTests.js",
    "test:withdrawal:integration": "node tests/scripts/runIntegrationTests.js apps/api/tests/withdrawalPostgres.integration.test.js",
    "test:finance-reconcile": "node --test apps/api/tests/financeReconcile.test.js",
    "finance:reconcile:test": "npm run test:finance-reconcile",
    "test:coverage": "npm run test:unit:coverage && npm run test:web:coverage",
    "test:api:coverage": "npm run test:unit:coverage",
    "test:web:coverage": "npm --prefix apps/web run test:coverage",
    "test:frontend:coverage": "npm --prefix apps/web run test:coverage",
    "lint": "npm --prefix apps/web run lint",
    "build": "npm --prefix apps/web run build",
    "db:test:setup": "node tests/scripts/dbTestSetup.js",
    "db:test:teardown": "node tests/scripts/dbTestTeardown.js"
  }
}
