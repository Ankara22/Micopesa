# --- Core ---
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/micopesa
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
FRONTEND_BASE_URL=http://localhost:5173
PROFILE_PHOTO_STORAGE_DIR=

# --- Email (verification and password reset, Gmail SMTP app password) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- SMS (Africa's Talking, used for staff onboarding) ---
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# --- M-Pesa STK Push (Safaricom Daraja sandbox) ---
# Payments are OFF unless MPESA_STK_ENABLED=true AND MPESA_CALLBACK_SECRET is 24+ characters.
MPESA_STK_ENABLED=false
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Random secret that is part of the callback path. Generate with: openssl rand -hex 24
MPESA_CALLBACK_SECRET=
# Public HTTPS URL Daraja can reach, ending with the secret:
# https://your-domain.example/api/mpesa/callback/<MPESA_CALLBACK_SECRET>
MPESA_CALLBACK_URL=
# Smallest contribution accepted through STK Push, in whole KES (default 50)
MPESA_MIN_AMOUNT=50
