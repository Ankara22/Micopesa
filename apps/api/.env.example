PORT=5000
# Email links use the canonical local frontend in development; production must use HTTPS.
FRONTEND_BASE_URL=http://localhost:5173
DATABASE_URL=postgresql://username:password@localhost:5432/Micopesa
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# National ID AES-GCM and HMAC key material must be separate canonical
# base64 encodings of 32 random bytes. Do not use example values here.
# NATIONAL_ID_ENCRYPTION_KEY=
# NATIONAL_ID_FINGERPRINT_KEY=

# LOCAL DEVELOPMENT ONLY. When true, POST /api/auth/register additionally
# accepts a client-supplied "role" (WORKER, FUND_MANAGER, REGULATOR, ADMIN)
# so a developer can create test accounts for every role. Must be false (or
# absent) in production - when false, public registration always creates a
# WORKER regardless of what "role" the client sends.
ALLOW_PRIVILEGED_SIGNUP=false

# Development SMS/email delivery is disabled by default. It is available only
# when NODE_ENV is unset or development and the global, channel-specific, and
# provider configuration checks pass. SMS uses the configured Mobile Sasa
# adapter; email uses its independently configured provider (Gmail SMTP by
# default). Verified account notifications do not require individual recipient
# allowlisting. The allowlists below remain for ad-hoc/non-account delivery.
# These switches do not start the production notification dispatcher.
COMMUNICATIONS_DEV_DELIVERY_ENABLED=false
COMMUNICATIONS_DEV_SMS_ENABLED=false
COMMUNICATIONS_DEV_EMAIL_ENABLED=false
COMMUNICATIONS_DEV_ALLOWED_PHONES=
COMMUNICATIONS_DEV_ALLOWED_EMAILS=

# Safaricom Daraja STK Push configuration (server-side only).
# Sandbox is selected explicitly; dispatch remains disabled by default.
DARAJA_ENV=sandbox
MPESA_PROVIDER_DISPATCH_ENABLED=false
MPESA_SANDBOX_ENABLED=false
MPESA_LIVE_PAYMENTS_ENABLED=false
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
DARAJA_BUSINESS_SHORTCODE=
# Must be a publicly reachable HTTPS URL routed to POST /api/mpesa/callback
DARAJA_CALLBACK_URL=
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline

# Supported legacy aliases (use one naming set; if both are set, values must match):
# MPESA_ENVIRONMENT=                 # DARAJA_ENV
# MPESA_DARAJA_ENVIRONMENT=          # DARAJA_ENV
# MPESA_CONSUMER_KEY=                # DARAJA_CONSUMER_KEY
# MPESA_CONSUMER_SECRET=             # DARAJA_CONSUMER_SECRET
# MPESA_PASSKEY=                     # DARAJA_PASSKEY
# MPESA_BUSINESS_SHORTCODE=          # DARAJA_BUSINESS_SHORTCODE
# MPESA_SHORTCODE=                   # DARAJA_BUSINESS_SHORTCODE
# MPESA_CALLBACK_URL=                # DARAJA_CALLBACK_URL
# MPESA_TRANSACTION_TYPE=            # DARAJA_TRANSACTION_TYPE
MOBILESASA_NOTIFICATION_SMS_ENABLED=false
