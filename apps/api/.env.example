PORT=5000
DATABASE_URL=postgresql://username:password@localhost:5432/Micopesa
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# LOCAL DEVELOPMENT ONLY. When true, POST /api/auth/register additionally
# accepts a client-supplied "role" (WORKER, FUND_MANAGER, REGULATOR, ADMIN)
# so a developer can create test accounts for every role. Must be false (or
# absent) in production - when false, public registration always creates a
# WORKER regardless of what "role" the client sends.
ALLOW_PRIVILEGED_SIGNUP=false
