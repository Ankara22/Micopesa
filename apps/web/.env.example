VITE_API_URL=http://localhost:5000

# LOCAL DEVELOPMENT ONLY. Must match the backend's ALLOW_PRIVILEGED_SIGNUP
# flag. When true, the Register page shows a Role selector (WORKER,
# FUND_MANAGER, REGULATOR, ADMIN). When false or absent, the Register page
# behaves exactly like the current worker-only registration form. Never
# enable this in production.
VITE_ALLOW_PRIVILEGED_SIGNUP=false

